{
  "manifestVersion": 2,
  "id": "design-canvas",
  "name": "Design canvas",
  "version": "0.1.0",
  "description": "Where people and agents design together: HTML artboards on a canvas, with comments, edits and tweaks the agent revises.",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/index.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "canvas",
        "title": "Design canvas",
        "extensions": [
          ".design.json"
        ],
        "entry": "editor/main.ts",
        "icon": "assets/icon.png",
        "frame": "isolated",
        "priority": "default"
      }
    ],
    "commands": [
      {
        "id": "design.openCanvas",
        "title": "Design: Open canvas",
        "when": "workspace"
      },
      {
        "id": "design.newDesign",
        "title": "Design: New design\u2026",
        "when": "workspace"
      }
    ],
    "keybindings": [
      {
        "command": "design.openCanvas",
        "key": "Mod+Alt+D",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "design",
        "text": "Design",
        "icon": "layers",
        "tooltip": "Open the design canvas",
        "command": "design.openCanvas"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "panels": [
      {
        "id": "home",
        "title": "Design",
        "icon": "layers",
        "entry": "panel/home.ts",
        "ui": "html"
      }
    ]
  }
}
